# === Demo Fiscal IA Melilla — env template ===
# Copy to `.env` on VPS (Coolify reads it via env_file) and fill real values.

# --- Demo mode ---
DEMO_MODE=true
BRAND_NAME=Fiscal IA Melilla
BRAND_DOMAIN=fiscal-melilla.demo
SUBSCRIPTIONS_ENABLED=false
RAG_TERRITORY_LOCK=Melilla
DEMO_USER_EMAIL=demo@fiscal-melilla.demo
DEMO_USER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Core APIs (cloud) ---
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
GOOGLE_GEMINI_API_KEY=...

# --- Storage ---
TURSO_DATABASE_URL=libsql://...
TURSO_AUTH_TOKEN=...
UPSTASH_REDIS_REST_URL=...
UPSTASH_REDIS_REST_TOKEN=...
UPSTASH_VECTOR_RAG_URL=...
UPSTASH_VECTOR_RAG_TOKEN=...

# --- Semantic cache (optional — set ENABLE_SEMANTIC_CACHE=false to skip) ---
# Separate Upstash Vector index from the RAG one above. If you don't want
# a semantic cache, leave these blank AND set ENABLE_SEMANTIC_CACHE=false below.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
ENABLE_SEMANTIC_CACHE=false

# --- Auth ---
# Generate fresh: openssl rand -hex 32  -- DO NOT reuse Impuestify prod key
JWT_SECRET_KEY=GENERATE_FRESH_32_BYTES_HEX
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Admin / Observability ---
# Generate fresh: openssl rand -hex 32. DO NOT leave at default (config.py has a placeholder).
ADMIN_API_KEY=GENERATE_FRESH_32_BYTES_HEX
LOG_LEVEL=WARNING

# --- Email ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=demo@fiscal-melilla.demo

# --- CORS / Frontend ---
ALLOWED_ORIGINS=https://fiscal-melilla.demo,http://localhost:5173
FRONTEND_URL=https://fiscal-melilla.demo

# --- DefensIA storage (REQUIRED si DefensIA tools activas) ---
# Sin esto, uploads DefensIA devuelven 503. Generar: openssl rand -hex 32
DEFENSIA_STORAGE_KEY=GENERATE_FRESH_32_BYTES_HEX

# =====================================================================
# --- Leadbot (chatbot captador de leads, demo IA Melilla) ---
# Sólo activo con DEMO_MODE=true. Runbook: ../IA-Melilla/docs/deploy/leadbot-config.md
# =====================================================================
# Email del dominio (SiteGround SMTP) — NO Resend
SMTP_HOST=smtp.iamelilla.com
SMTP_PORT=465
SMTP_USER=hola@iamelilla.com
SMTP_PASSWORD=APP_PASSWORD_SITEGROUND
SMTP_FROM_EMAIL=hola@iamelilla.com
SMTP_FROM_NAME=Fiscal IA Melilla
# Dónde recibe Joaquín los avisos de lead
LEADBOT_OWNER_NOTIFY_EMAIL=hola@iamelilla.com
# URL pública del backend (para el magic-link de confirmación de cita)
LEADBOT_PUBLIC_BASE_URL=https://api.iamelilla.com
# Google Calendar (rellenar tras grant OAuth — ver leadbot-config.md)
CALENDAR_TOKEN_KEY=GENERATE_FERNET_KEY
LEADBOT_CALENDAR_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Disponibilidad (provisional — ajustar tras reunión Joaquín). weekday: lun=0..dom=6
LEADBOT_TIMEZONE=Europe/Madrid
LEADBOT_WORK_DAYS=0,1,2,3,4
LEADBOT_WORK_HOURS=10:00-14:00,17:00-20:00
LEADBOT_SLOT_MINUTES=30
LEADBOT_BUFFER_MINUTES=15
# Turnstile opcional (si se pone secret, el chat exige captcha)
# TURNSTILE_SECRET_KEY=
